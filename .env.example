# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wedding

# Backend auth - CHANGE THESE before deploying
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# URLs
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Vercel + Supabase only (see DEPLOY.md); leave empty for docker-compose ---
# Supabase "Transaction pooler" connection string; overrides the DB_* values above
DATABASE_URL=
# when set, photos go to Supabase Storage instead of UPLOAD_DIR
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=uploads
# ALLOWED_ORIGIN accepts a comma-separated list, e.g. https://ours.vercel.app,https://ourwedding.com

# Optional: Fonnte (fonnte.com) device token to send WhatsApp invitations from the
# server. Leave empty to send each one by opening WhatsApp from the admin page.
FONNTE_TOKEN=

# Optional: comma-separated IPs/CIDRs of a reverse proxy (e.g. nginx) in front of
# the API, so rate limits see real client IPs. Not needed on Vercel.
TRUSTED_PROXIES=
